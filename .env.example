# --- Required ---------------------------------------------------------------
# API-Football key from https://dashboard.api-football.com (free plan: 100 req/day)
API_FOOTBALL_KEY=

# Vercel AI Gateway key (https://vercel.com/ai-gateway). On Vercel deployments
# the OIDC token is used automatically; locally run `vercel env pull` or set this.
AI_GATEWAY_API_KEY=

# --- Recommended in production ---------------------------------------------
# Upstash Redis (Vercel Marketplace sets KV_REST_API_URL / KV_REST_API_TOKEN).
# Without it, a local file cache in .cache/ is used (dev only).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Protects /api/cron/warm (Vercel Cron sends it as a Bearer token).
CRON_SECRET=

# --- Optional ----------------------------------------------------------------
# Any AI Gateway model id.
REPORT_MODEL=anthropic/claude-sonnet-5.5
CHAT_MODEL=anthropic/claude-haiku-5.5
REPORTS_PER_IP_PER_DAY=10
CHAT_MESSAGES_PER_IP_PER_HOUR=40
# Canonical URL used for OG/canonical links.
SITE_URL=
