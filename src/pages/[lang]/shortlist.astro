---
import Base from '../../layouts/Base.astro';
import ShortlistView from '../../components/ShortlistView';
import { isLang, t } from '../../lib/i18n';

export const prerender = false;

const { lang } = Astro.params;
if (!isLang(lang)) return Astro.redirect('/en', 302);
const d = t(lang);
---

<Base lang={lang} title={d.shortlist.title} active="shortlist">
  <div class="wrap py-10 md:py-14">
    <h1 class="display text-[clamp(3rem,9vw,6.5rem)]">{d.shortlist.title}</h1>
    <div class="mt-8 max-w-3xl">
      <ShortlistView client:load lang={lang} strings={d.shortlist} positions={d.positions} removeLabel={d.shortlist.clear} />
    </div>
  </div>
</Base>
