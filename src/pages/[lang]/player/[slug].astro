---
import Base from '../../../layouts/Base.astro';
import PercentilePanel from '../../../components/PercentilePanel';
import ReportPanel from '../../../components/ReportPanel';
import ScoutChat from '../../../components/ScoutChat';
import FitPanel from '../../../components/FitPanel';
import SimilarPanel from '../../../components/SimilarPanel';
import PlayerActions from '../../../components/PlayerActions';
import { isLang, t } from '../../../lib/i18n';
import { getPlayerProfile } from '../../../lib/football/service';
import { idFromSlug, slugify } from '../../../lib/football/normalize';
import { dataErrorMessage, peerNote, poolWarning, seasonText, slicesFor } from '../../../lib/view';
import type { PlayerProfile } from '../../../lib/football/types';

export const prerender = false;

const { lang, slug = '' } = Astro.params;
if (!isLang(lang)) return Astro.redirect('/en', 302);
const d = t(lang);
const id = idFromSlug(slug);
const seasonParam = Number(Astro.url.searchParams.get('season')) || undefined;

let profile: PlayerProfile | null = null;
let errorMessage: string | null = null;
if (id) {
  try {
    profile = await getPlayerProfile(id, seasonParam);
  } catch (e) {
    errorMessage = dataErrorMessage(e, lang);
  }
}

if (profile) {
  const canonicalSlug = slugify(profile.name, profile.id);
  if (canonicalSlug !== slug) return Astro.redirect(`/${lang}/player/${canonicalSlug}${Astro.url.search}`, 301);
  Astro.response.headers.set('Cache-Control', 'public, s-maxage=3600, stale-while-revalidate=86400');
} else {
  Astro.response.status = errorMessage ? 503 : 404;
}

const slices = profile ? slicesFor(profile, lang) : [];
const metricLabels = Object.fromEntries(slices.map((s) => [s.key, s.label]));
const facts = profile
  ? [
      { label: d.player.age, value: profile.age ? `${profile.age}` : '—' },
      { label: d.player.minutes, value: profile.minutes.toLocaleString(lang) },
      { label: d.player.apps, value: `${profile.appearances}`, sub: `${profile.starts} ${d.player.starts}` },
      { label: d.player.goals, value: `${profile.totals.goals}` },
      { label: d.player.assists, value: `${profile.totals.assists}` },
      { label: d.player.rating, value: profile.rating ? profile.rating.toFixed(2) : '—' },
    ]
  : [];
const description = profile
  ? `${profile.fullName}: ${profile.position ? d.positions[profile.position] : ''}, ${profile.team?.name ?? ''}, ${profile.league?.name ?? ''} ${seasonText(profile)}. ${d.meta.description}`
  : undefined;
---

<Base lang={lang} title={profile?.name ?? d.player.notFound} description={description} ogImage={profile ? `/api/og/${profile.id}.png?lang=${lang}` : undefined}>
  {
    !profile ? (
      <div class="wrap py-24">
        <h1 class="display text-6xl">{d.player.notFound}</h1>
        <p class="mt-4 max-w-xl text-chalk-dim">{errorMessage ?? d.player.notFoundBody}</p>
        <a href={`/${lang}`} class="btn btn-primary mt-8">
          {d.landing.searchCta}
        </a>
      </div>
    ) : (
      <article>
        {/* Identity strip */}
        <header class="border-b border-line">
          <div class="wrap grid gap-6 py-8 md:grid-cols-[auto_1fr] md:items-end md:py-12">
            <div class="relative h-[132px] w-[132px] shrink-0 overflow-hidden rounded-md border border-line bg-turf md:h-[168px] md:w-[168px]">
              <img src={profile.photo} alt={profile.name} width="168" height="168" class="h-full w-full object-cover" />
              {profile.team?.logo && (
                <img src={profile.team.logo} alt="" width="40" height="40" class="absolute bottom-2 right-2 h-10 w-10 rounded bg-pitch/80 object-contain p-1" />
              )}
            </div>
            <div class="min-w-0">
              <p class="text-chalk-dim">
                {profile.position && <span class="font-semibold text-flood">{d.positions[profile.position]}</span>}
                <span class="mx-2 text-chalk-faint" aria-hidden="true">/</span>
                {profile.team?.name}
                <span class="mx-2 text-chalk-faint" aria-hidden="true">/</span>
                {profile.league?.name} {seasonText(profile)}
              </p>
              <h1 class="display mt-2 break-words text-[clamp(3.4rem,11vw,8.5rem)]">{profile.name}</h1>
              {profile.fullName !== profile.name && <p class="mt-2 text-chalk-faint">{profile.fullName}{profile.nationality ? `, ${profile.nationality}` : ''}</p>}
            </div>
          </div>
          <div class="wrap pb-6">
            <dl class="grid grid-cols-3 gap-px overflow-hidden rounded-md border border-line bg-line sm:grid-cols-6">
              {
                facts.map((f) => (
                  <div class="bg-pitch px-4 py-3">
                    <dt class="text-xs text-chalk-faint">{f.label}</dt>
                    <dd class="display num mt-1 text-[2.1rem]">
                      {f.value}
                      {f.sub && <span class="ml-1 font-sans text-xs font-normal text-chalk-faint" style="font-variation-settings: 'wdth' 100">{f.sub}</span>}
                    </dd>
                  </div>
                ))
              }
            </dl>
            <div class="mt-5">
              <PlayerActions
                client:load
                item={{
                  id: profile.id,
                  slug: slugify(profile.name, profile.id),
                  name: profile.name,
                  photo: profile.photo,
                  position: profile.position,
                  team: profile.team?.name ?? null,
                  league: profile.league?.name ?? null,
                  age: profile.age,
                }}
                compareHref={`/${lang}/compare?a=${profile.id}`}
                strings={d.player}
              />
            </div>
          </div>
        </header>

        {/* Dossier body */}
        <div class="wrap mt-8 grid gap-6 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,1fr)]">
          <PercentilePanel
            client:load
            slices={slices}
            title={d.player.percentiles}
            note={peerNote(profile, lang)}
            warning={poolWarning(profile, lang)}
            centerValue={profile.rating ? profile.rating.toFixed(1) : undefined}
            centerLabel={profile.rating ? d.player.rating : undefined}
            strings={{ ...d.player, metric: d.compare.metric }}
          />
          <ReportPanel client:load playerId={profile.id} season={profile.season} lang={lang} playerName={profile.name} metricLabels={metricLabels} strings={d.report} />
        </div>

        <div class="wrap mt-6 grid gap-6 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,1fr)]">
          <ScoutChat client:visible playerId={profile.id} season={profile.season} lang={lang} playerName={profile.name} strings={d.chat} />
          <div class="grid content-start gap-6">
            <FitPanel client:visible playerId={profile.id} season={profile.season} lang={lang} strings={d.fit} errorText={d.report.error} />
            <SimilarPanel client:visible playerId={profile.id} season={profile.season} lang={lang} strings={d.similar} yearsLabel={d.player.years} />
          </div>
        </div>
      </article>
    )
  }
</Base>
