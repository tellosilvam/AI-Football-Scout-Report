---
import '../styles/global.css';
import type { Lang } from '../lib/ai/schema';
import { LANG_LABEL, t } from '../lib/i18n';
import { LANGS } from '../lib/ai/schema';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  ogImage?: string;
  active?: 'search' | 'discover' | 'compare' | 'shortlist' | 'stats';
}

const { lang, title, description, ogImage, active } = Astro.props;
const d = t(lang);
const pageTitle = title ? `${title} · AI Scout` : d.meta.title;
const pageDescription = description ?? d.meta.description;
const site = Astro.site ?? new URL(Astro.url.origin);
const og = new URL(ogImage ?? `/api/og/default.png?lang=${lang}`, site).toString();
const canonical = new URL(Astro.url.pathname, site).toString();

// Same path in another language: /es/player/x → /fr/player/x
const restOfPath = Astro.url.pathname.split('/').slice(2).join('/');
const altHref = (l: Lang) => `/${l}/${restOfPath}${Astro.url.search}`;

const nav = [
  { key: 'discover', href: `/${lang}/discover`, label: d.nav.discover },
  { key: 'compare', href: `/${lang}/compare`, label: d.nav.compare },
  { key: 'shortlist', href: `/${lang}/shortlist`, label: d.nav.shortlist },
] as const;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonical} />
    {LANGS.map((l) => <link rel="alternate" hreflang={l} href={new URL(altHref(l), site).toString()} />)}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#0e1a14" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={og} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,100..900&display=swap" rel="stylesheet" />
    <script is:inline>
      try {
        const saved = localStorage.getItem('aiscout-theme');
        if (saved === 'light' || saved === 'dark') document.documentElement.dataset.theme = saved;
      } catch {}
    </script>
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 btn btn-primary">Skip to content</a>
    <header class="no-print border-b border-line">
      <div class="wrap flex flex-wrap items-center gap-x-4 gap-y-1 py-3">
        <a href={`/${lang}`} class="flex items-baseline gap-2 no-underline" aria-label="AI Scout home">
          <span class="display whitespace-nowrap text-[1.9rem] text-chalk">AI Scout</span>
        </a>
        <nav aria-label="Main" class="order-last -mx-3 flex w-full items-center gap-1 overflow-x-auto sm:order-none sm:mx-0 sm:ml-auto sm:w-auto">
          {
            nav.map((item) => (
              <a
                href={item.href}
                aria-current={active === item.key ? 'page' : undefined}
                class:list={[
                  'rounded-md px-3 py-2 text-[0.95rem] font-medium whitespace-nowrap',
                  active === item.key ? 'text-chalk bg-turf-2' : 'text-chalk-dim hover:text-chalk',
                ]}
              >
                {item.label}
              </a>
            ))
          }
        </nav>
        <details class="relative ml-auto sm:ml-0">
          <summary class="btn min-h-[40px] px-3 list-none cursor-pointer" aria-label="Language">{lang.toUpperCase()}</summary>
          <ul class="sheet absolute right-0 z-30 mt-2 w-40 p-1">
            {
              LANGS.map((l) => (
                <li>
                  <a href={altHref(l)} hreflang={l} lang={l} class:list={['block rounded px-3 py-2', l === lang ? 'text-flood' : 'hover:bg-turf-2']}>
                    {LANG_LABEL[l]}
                  </a>
                </li>
              ))
            }
          </ul>
        </details>
        <button id="theme-toggle" class="btn min-h-[40px] px-3" type="button" aria-label="Toggle colour theme">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="12" cy="12" r="5"></circle><path d="M12 1v2M12 21v2M4.2 4.2l1.4 1.4M18.4 18.4l1.4 1.4M1 12h2M21 12h2M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4"></path>
          </svg>
        </button>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="no-print mt-24 border-t border-line">
      <div class="wrap flex flex-col gap-3 py-8 text-sm text-chalk-faint md:flex-row md:items-center md:justify-between">
        <p>{d.footer.data} {d.footer.disclaimer}</p>
        <p class="flex gap-4">
          <a class="hover:text-chalk" href={`/${lang}/stats`}>{d.nav.stats}</a>
          <a class="hover:text-chalk" href="https://github.com/tellosilvam/AI-Football-Scout-Report" rel="noopener">{d.footer.source}</a>
          <a class="hover:text-chalk" href="https://migueltello.site" rel="noopener">{d.footer.by}</a>
        </p>
      </div>
    </footer>

    <script is:inline>
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const root = document.documentElement;
        const current = root.dataset.theme ?? (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
        const next = current === 'light' ? 'dark' : 'light';
        root.dataset.theme = next;
        try {
          localStorage.setItem('aiscout-theme', next);
        } catch {}
      });
    </script>
  </body>
</html>
